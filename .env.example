SIM_DATABASE_URL=postgresql+psycopg://sim:sim@localhost:5432/sim
# Local Homebrew Postgres example:
# SIM_DATABASE_URL=postgresql+psycopg://ramprayaga@localhost:5432/sim

# Hosted TypeSafe Jev (System 1) — https://docs.typesafe.ai/api
# Create a key in the TypeSafe console; TYPEFACE_API_KEY is accepted as an alias.
TYPESAFE_API_KEY=
# TYPEFACE_API_KEY=

# Optional: local openjev-server on :3000 (models.system1: openjev-local)
# OPENJEV_TOKEN=

# Hugging Face — only needed to download local MLX weights
# HF_TOKEN=
